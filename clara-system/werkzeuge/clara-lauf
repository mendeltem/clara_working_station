#!/usr/bin/env bash
# clara-lauf ORT MODELL THEMA AUFTRAG -- one job of the continuous run, using clara-agent instead of hermes -z (since 29.10.2026).
#
#   ORT     cle | lokal       lokal forces the local model for every request (Weiche relay, model "lokal");
#                             cle uses MODELL (Clé alias); the Weiche still switches to lokal as soon as a
#                             request carries ids, cohort names or data paths
#   THEMA   name in system/themen/ or empty: the brief goes BEFORE the job (prefill, like hermes -s)
#
# Write lock: clara --yolo with Landlock + seccomp (sandbox.unix_sockets = "allow" so torch DataLoaders work):
# writes only in the project, /tmp and the paths from system/schreibsperre.liste; TCP only to 8770 (model),
# 8765 (System One), 8899 (watchdog/frag-draussen); no UDP, no ICMP. Sessions: ~/.clara-lauf/sessions
# (werkzeuge/clara-sitzungen reads them). Output: answer on stdout, tool trace on stderr.
set -uo pipefail
B="${CLARA_SYSTEM:-$HOME/local_agentic_system/system}"
ORT="${1:?ORT}"; MODELL="${2:-auto}"; THEMA="${3:-}"; AUFTRAG="${4:-}"   # without AUFTRAG: interactive
# Two homes: lokal with Clara's full memory (project profile), cle with the Clé-safe one (no cohort knowledge)
if [ "$ORT" = lokal ]; then
    export CLARA_HOME="${CLARA_LAUF_HOME:-$HOME/.clara-lauf}"; MEM="${CLARA_MEM_LOKAL:-$HOME/.hermes/profiles/projekt/memories/MEMORY.md}"
else
    export CLARA_HOME="${CLARA_LAUF_HOME:-$HOME/.clara-lauf-cle}"; MEM="${CLARA_MEM_CLE:-$HOME/.hermes/profiles/cle/memories/MEMORY.md}"
fi
mkdir -p "$CLARA_HOME"
[ -s "$CLARA_HOME/memory.md" ] || cp "$MEM" "$CLARA_HOME/memory.md" 2>/dev/null

# Write paths from the shared list (one source for the Hermes write lock and clara)
PFADE=$(grep -v '^\s*#' "$B/schreibsperre.liste" | sed 's/#.*//' | awk 'NF==1 {print $1}' | sed "s|^~|$HOME|" \
        | while read -r p; do [ -d "$p" ] && printf '"%s", ' "$p"; done)
cat > "$CLARA_HOME/config.toml" <<EOF
# generated by werkzeuge/clara-lauf -- do not edit by hand
[model]
base_url = "http://127.0.0.1:8770/v1"
model = "auto"
tool_mode = "native"
timeout = 1800
[network]
allowed_hosts = ["127.0.0.1", "::1", "localhost"]
[sandbox]
mode = "on"
extra_write_paths = [${PFADE%, }]
extra_connect_ports = [8899]
unix_sockets = "allow"
[permissions]
approver_url = "http://127.0.0.1:8765/v1/chat/completions"
[agent]
max_turns = 400
show_reasoning = false
EOF

if [ "$ORT" = lokal ]; then export CLARA_MODEL=lokal; else export CLARA_MODEL="${MODELL:-auto}"; fi
TEXT="$AUFTRAG"
if [ -n "$AUFTRAG" ] && [ -n "$THEMA" ] && [ -f "$B/themen/$THEMA.md" ]; then
    TEXT="TOPIC BRIEF ($THEMA, preloaded):
$(cat "$B/themen/$THEMA.md")

---
JOB:
$AUFTRAG"
fi
echo "clara-lauf: $ORT, model $CLARA_MODEL${THEMA:+, topic $THEMA}, $(pwd)" >&2
if [ -z "$AUFTRAG" ]; then
    # interactive: asks before writes and commands (System One first), write lock on as in the continuous run
    exec "$HOME/.clara-venv/bin/clara" -C "$PWD"
fi
exec "$HOME/.clara-venv/bin/clara" -C "$PWD" -p "$TEXT" --yolo --quiet
